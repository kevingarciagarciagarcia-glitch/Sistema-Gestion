<%- include('../partials/header', { currentPage: 'units' }) %>

<h1>Unidades de medida</h1>

<% if (query.error) { %>
  <div class="alert error"><%= query.error %></div>
<% } %>

<div class="card">
  <h2>Nueva unidad</h2>
  <form method="post" action="/inventario/unidades">
    <div class="form-grid">
      <div class="field">
        <label for="name">Nombre</label>
        <input type="text" id="name" name="name" placeholder="Ej: Caja, Kilogramo, Litro..." required>
      </div>
    </div>
    <button class="btn" type="submit">Agregar unidad</button>
  </form>
</div>

<div class="card">
  <h2>Lista de unidades</h2>
  <% if (units.length === 0) { %>
    <p class="empty">Todavía no hay unidades.</p>
  <% } else { %>
    <table>
      <thead>
        <tr><th>Nombre</th><th>Productos</th><th></th></tr>
      </thead>
      <tbody>
        <% units.forEach(u => { %>
          <tr>
            <td><%= u.name %></td>
            <td><%= u.product_count %></td>
            <td class="actions-cell">
              <% if (u.product_count > 0 || u.conversion_count > 0) { %>
                <span class="muted" title="No se puede eliminar: en uso por productos o conversiones">En uso</span>
              <% } else { %>
                <form class="inline" method="post" action="/inventario/unidades/<%= u.id %>/delete" onsubmit="return confirm('¿Eliminar esta unidad?');">
                  <button class="btn danger" type="submit">Eliminar</button>
                </form>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>

<%- include('../partials/footer') %>
