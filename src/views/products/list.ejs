<%- include('../partials/header', { currentPage: 'products' }) %>

<h1>Productos</h1>

<% if (query.error) { %>
  <div class="alert error"><%= query.error %></div>
<% } %>

<div class="toolbar">
  <form class="search-box" method="get" action="/inventario/productos">
    <input type="text" name="q" placeholder="Buscar por nombre o SKU..." value="<%= search %>">
  </form>
  <a class="btn" href="/inventario/productos/new">+ Nuevo producto</a>
</div>

<div class="card">
  <% if (products.length === 0) { %>
    <p class="empty">No se encontraron productos.</p>
  <% } else {
    const fuelleLabel = (p) => {
      if (!p.has_fuelle) return '—';
      if (p.fuelle_type === 'lateral') return `Lat: ${p.fuelle_measure_1 ?? '—'}`;
      if (p.fuelle_type === 'fondo') return `Fon: ${p.fuelle_measure_1 ?? '—'}`;
      if (p.fuelle_type === 'superior_fondo') return `Sup: ${p.fuelle_measure_1 ?? '—'} / Fon: ${p.fuelle_measure_2 ?? '—'}`;
      return '—';
    };
  %>
    <div style="overflow-x: auto;">
    <table>
      <thead>
        <tr>
          <th>SKU</th><th>Nombre</th>
          <th>Color</th><th title="Ancho">A</th><th title="Largo">L</th><th title="Espesor">E</th><th title="Fuelle">F</th>
          <th>Categoría</th><th>Unidad</th><th>Stock</th><th>Mínimo</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% products.forEach(p => { %>
          <tr>
            <td><%= p.sku %></td>
            <td><%= p.name %></td>
            <td><%= p.color || '—' %></td>
            <td><%= p.width ?? '—' %></td>
            <td><%= p.length ?? '—' %></td>
            <td><%= p.thickness ?? '—' %></td>
            <td><%= fuelleLabel(p) %></td>
            <td><%= p.category_name || '—' %></td>
            <td><%= p.unit_name || '—' %></td>
            <td>
              <% if (p.quantity <= p.min_stock) { %>
                <span class="badge low"><%= p.quantity %></span>
              <% } else { %>
                <%= p.quantity %>
              <% } %>
            </td>
            <td><%= p.min_stock %></td>
            <td class="actions-cell">
              <a class="btn secondary" href="/inventario/productos/<%= p.id %>/edit">Editar</a>
              <form class="inline" method="post" action="/inventario/productos/<%= p.id %>/delete" onsubmit="return confirm('¿Eliminar este producto?');">
                <button class="btn danger" type="submit">Eliminar</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
