<%- include('../partials/header', { currentPage: 'materia_prima' }) %>

<h1>Inventario · Materia Prima</h1>

<% if (query.error) { %>
  <div class="alert error"><%= query.error %></div>
<% } %>

<%- include('../partials/import-result') %>

<div class="toolbar">
  <form class="search-box" method="get" action="/inventario/productos/materia-prima">
    <input type="text" name="q" placeholder="Buscar por nombre o SKU..." value="<%= search %>">
  </form>
  <div style="display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap;">
    <%- include('../partials/bulk-import-buttons', { templateUrl: '/inventario/productos/materia-prima/plantilla', importUrl: '/inventario/productos/materia-prima/importar' }) %>
    <a class="btn" href="/inventario/productos/new?category_id=<%= topCategoryId %>">+ Nuevo producto</a>
  </div>
</div>

<div class="card">
  <% if (products.length === 0) { %>
    <p class="empty">No hay productos de materia prima registrados.</p>
  <% } else { %>
    <div style="overflow-x: auto;">
    <table>
      <thead>
        <tr>
          <th>SKU</th><th>Nombre</th><th>Código</th><th>Marca</th>
          <th>Subcategoría</th><th>Unidad</th><th>Presentación</th><th>Stock</th><th>Mínimo</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% products.forEach(p => { %>
          <tr>
            <td><%= p.sku %></td>
            <td><%= p.name %></td>
            <td><%= p.spec_code || '—' %></td>
            <td><%= p.spec_brand || '—' %></td>
            <td><%= p.category_name || '—' %></td>
            <td><%= p.unit_name || '—' %></td>
            <td><%= p.spec_presentation || '—' %></td>
            <td>
              <% if (p.quantity <= p.min_stock) { %>
                <span class="badge low"><%= p.quantity %></span>
              <% } else { %>
                <%= p.quantity %>
              <% } %>
            </td>
            <td><%= p.min_stock %></td>
            <td class="actions-cell">
              <a class="btn secondary" href="/inventario/productos/<%= p.id %>/edit">Editar</a>
              <form class="inline" method="post" action="/inventario/productos/<%= p.id %>/delete" onsubmit="return confirm('¿Eliminar este producto?');">
                <button class="btn danger" type="submit">Eliminar</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
