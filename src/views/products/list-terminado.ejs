<%- include('../partials/header', { currentPage: 'terminado' }) %>

<h1>Inventario · Producto Terminado</h1>

<% if (query.error) { %>
  <div class="alert error"><%= query.error %></div>
<% } %>

<%- include('../partials/import-result') %>

<div class="toolbar">
  <form class="search-box" method="get" action="/inventario/productos/terminado">
    <input type="text" class="search-main" name="q" placeholder="Buscar por nombre o SKU..." value="<%= search %>">
    <div class="search-extra">
      <input type="text" class="search-filter" name="medidas" placeholder="Medidas (20X30)" value="<%= measures %>">
      <input type="text" class="search-filter" name="color" placeholder="Color" value="<%= color %>">
      <button class="btn secondary" type="submit">Buscar</button>
    </div>
  </form>
  <div style="display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap;">
    <%- include('../partials/bulk-import-buttons', { templateUrl: '/inventario/productos/terminado/plantilla', importUrl: '/inventario/productos/terminado/importar' }) %>
    <a class="btn" href="/inventario/productos/new?category_id=<%= topCategoryId %>">+ Nuevo producto</a>
  </div>
</div>

<div class="card">
  <% if (products.length === 0) { %>
    <p class="empty">No hay productos terminados registrados.</p>
  <% } else { %>
    <form data-bulk-form method="post" action="/inventario/productos/bulk-delete" style="display:none;">
      <input type="hidden" name="category_id" value="<%= topCategoryId %>">
      <input type="hidden" name="redirect_to" data-bulk-redirect value="">
    </form>
    <form data-bulk-export-form method="post" action="/inventario/productos/export" style="display:none;">
      <input type="hidden" name="category_id" value="<%= topCategoryId %>">
      <input type="hidden" name="redirect_to" data-bulk-redirect value="">
    </form>

    <div class="bulk-bar" data-bulk-bar>
      <span><strong data-bulk-count>0</strong> seleccionado(s)</span>
      <button type="button" class="btn secondary" data-bulk-export>Exportar seleccionados</button>
      <button type="button" class="btn danger" data-bulk-delete>Eliminar seleccionados</button>
    </div>

    <div style="overflow-x: auto;">
    <table class="sortable-table" data-bulk-select>
      <thead>
        <tr>
          <th class="checkbox-col"><input type="checkbox" data-select-all></th>
          <th data-sort>SKU</th><th data-sort>Nombre</th>
          <th data-sort>Color</th><th data-sort title="Ancho">A</th><th data-sort title="Largo">L</th><th data-sort title="Espesor">E</th><th data-sort>Fuelle</th>
          <th data-sort>Referencia</th><th data-sort>Subcategoría</th><th data-sort>Unidad</th><th data-sort>Stock</th><th data-sort>Mínimo</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% products.forEach(p => { %>
          <tr>
            <td class="checkbox-col"><input type="checkbox" class="row-select" value="<%= p.id %>"></td>
            <td><%= p.sku %></td>
            <td><%= p.name %></td>
            <td><%- include('../partials/color-swatches', { colorText: p.color, colorHexByName }) %></td>
            <td><%= p.width ?? '—' %></td>
            <td><%= p.length ?? '—' %></td>
            <td><%= p.thickness ?? '—' %></td>
            <td>
              <% if (!p.has_fuelle) { %>—<%
                } else if (p.fuelle_type === 'lateral') { %>Lat: <%= p.fuelle_measure_1 ?? '—' %><%
                } else if (p.fuelle_type === 'fondo') { %>Fon: <%= p.fuelle_measure_1 ?? '—' %><%
                } else { %>Sup: <%= p.fuelle_measure_1 ?? '—' %> / Fon: <%= p.fuelle_measure_2 ?? '—' %><%
              } %>
            </td>
            <td><%= p.has_printing ? (p.printing_reference || '—') : '—' %></td>
            <td><%= p.category_name || '—' %></td>
            <td><%= p.unit_name || '—' %></td>
            <td>
              <% if (p.quantity <= p.min_stock) { %>
                <span class="badge low"><%= p.quantity %></span>
              <% } else { %>
                <%= p.quantity %>
              <% } %>
            </td>
            <td><%= p.min_stock %></td>
            <td class="actions-cell">
              <a class="btn secondary" href="/inventario/productos/<%= p.id %>/edit">Editar</a>
              <form class="inline" method="post" action="/inventario/productos/<%= p.id %>/delete" onsubmit="return confirm('¿Eliminar este producto?');">
                <button class="btn danger" type="submit">Eliminar</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
    </div>
  <% } %>
</div>

<script src="/js/table-sort.js"></script>
<script src="/js/bulk-select.js"></script>
<%- include('../partials/footer') %>
