<%- include('../partials/header', { currentPage: 'movements' }) %>

<div class="toolbar">
  <h1 style="margin: 0;">Hoja de Movimiento #<%= batch.id %></h1>
  <div style="display: flex; gap: 0.5rem;">
    <button type="button" class="btn secondary" onclick="window.print()">🖨 Imprimir</button>
    <a class="btn secondary" href="/inventario/movimientos">Volver</a>
  </div>
</div>

<div class="card" id="print-area">
  <div class="form-grid" style="margin-bottom: 1.5rem;">
    <div><span class="muted">Fecha</span><br><strong><%= batch.created_at %></strong></div>
    <div>
      <span class="muted">Tipo</span><br>
      <span class="badge <%= batch.type %>">
        <%= batch.type === 'in' ? 'Entrada' : batch.type === 'out' ? 'Salida' : 'Traspaso' %>
      </span>
    </div>
    <div>
      <span class="muted">Bodega</span><br>
      <strong>
        <% if (batch.type === 'traspaso') { %>
          <%= batch.from_warehouse_name || '—' %> → <%= batch.to_warehouse_name || '—' %>
        <% } else { %>
          <%= batch.warehouse_name || '—' %>
        <% } %>
      </strong>
    </div>
    <div><span class="muted">Motivo</span><br><strong><%= batch.reason || '—' %></strong></div>
  </div>

  <div style="overflow-x: auto;">
  <table>
    <thead>
      <tr><th>N°</th><th>Código</th><th>Elemento</th><th>Cantidad</th></tr>
    </thead>
    <tbody>
      <% lines.forEach((m, idx) => { %>
        <tr>
          <td><%= idx + 1 %></td>
          <td><%= m.item_code %></td>
          <td><%= m.item_name %></td>
          <td>
            <% if (m.input_unit_id && Number(m.input_unit_id) !== Number(m.item_unit_id)) { %>
              <%= m.input_quantity %> <%= m.input_unit_name %> <span class="muted">(= <%= m.quantity %> <%= m.unit_name || '—' %>)</span>
            <% } else { %>
              <%= m.quantity %> <%= m.unit_name || '—' %>
            <% } %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  </div>

  <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; margin-top: 3rem;">
    <div style="text-align: center;">
      <div style="border-top: 1px solid var(--text); padding-top: 0.5rem;">
        <strong><%= batch.created_by_full_name || batch.created_by_username || '—' %></strong>
      </div>
      <div class="muted">Elaborado por</div>
    </div>
    <div style="text-align: center;">
      <div style="border-top: 1px solid var(--text); padding-top: 0.5rem;">&nbsp;</div>
      <div class="muted">Aprobado por</div>
    </div>
    <div style="text-align: center;">
      <div style="border-top: 1px solid var(--text); padding-top: 0.5rem;">&nbsp;</div>
      <div class="muted">Recibido por</div>
    </div>
  </div>
</div>

<style>
  @media print {
    header.topbar, .toolbar, .sidebar, .sidebar-open-btn { display: none !important; }
    main { padding: 0; max-width: none; }
    #print-area { border: none; }
  }
</style>

<%- include('../partials/footer') %>
