<%- include('../partials/header', { currentPage: 'movements' }) %>

<h1><%= batch ? `Editar hoja de movimiento #${batch.id}` : 'Nuevo movimiento' %></h1>

<% if (query.error) { %>
  <div class="alert error"><%= query.error %></div>
<% } %>

<div class="card">
  <form method="post" action="<%= batch ? `/inventario/movimientos/lote/${batch.id}` : '/inventario/movimientos' %>" id="movement-form">
    <div class="form-grid" style="margin-bottom: 1rem;">
      <div class="field">
        <label for="type">Tipo de movimiento</label>
        <select id="type" name="type" required>
          <option value="in" <%= batch?.type === 'in' ? 'selected' : '' %>>Entrada</option>
          <option value="out" <%= batch?.type === 'out' ? 'selected' : '' %>>Salida</option>
          <option value="traspaso" id="traspaso-option" <%= batch?.type === 'traspaso' ? 'selected' : '' %>>Traspaso entre bodegas</option>
        </select>
      </div>
      <div class="field" id="single-warehouse-field">
        <label for="warehouse_id">Bodega</label>
        <select id="warehouse_id" name="warehouse_id">
          <option value="">Selecciona una bodega</option>
          <% warehouses.forEach(w => { %>
            <option value="<%= w.id %>" <%= batch?.warehouse_id === w.id ? 'selected' : '' %>><%= w.name %></option>
          <% }) %>
        </select>
      </div>
      <div class="field" id="from-warehouse-field" style="display: none;">
        <label for="from_warehouse_id">Bodega origen</label>
        <select id="from_warehouse_id" name="from_warehouse_id">
          <option value="">Selecciona una bodega</option>
          <% warehouses.forEach(w => { %>
            <option value="<%= w.id %>" <%= batch?.from_warehouse_id === w.id ? 'selected' : '' %>><%= w.name %></option>
          <% }) %>
        </select>
      </div>
      <div class="field" id="to-warehouse-field" style="display: none;">
        <label for="to_warehouse_id">Bodega destino</label>
        <select id="to_warehouse_id" name="to_warehouse_id">
          <option value="">Selecciona una bodega</option>
          <% warehouses.forEach(w => { %>
            <option value="<%= w.id %>" <%= batch?.to_warehouse_id === w.id ? 'selected' : '' %>><%= w.name %></option>
          <% }) %>
        </select>
      </div>
      <div class="field">
        <label for="reason">Motivo</label>
        <input type="text" id="reason" name="reason" placeholder="Ej: compra a proveedor, venta, ajuste..." value="<%= batch?.reason || '' %>">
      </div>
    </div>

    <h2>Productos / suministros</h2>
    <p class="muted" style="margin: -0.25rem 0 1rem;">Agrega todos los ítems que quieras incluir en esta misma hoja de movimiento.</p>

    <div style="overflow-x: auto;" id="items-table-wrapper">
    <table>
      <thead>
        <tr>
          <th style="width: 2rem;">N°</th>
          <th style="min-width: 280px;">Producto o suministro</th>
          <th style="width: 120px;">Cantidad</th>
          <th style="width: 160px;">Unidad</th>
          <th style="width: 2rem;"></th>
        </tr>
      </thead>
      <tbody id="items-body"></tbody>
    </table>
    </div>
    <button type="button" id="add-row-btn" class="btn secondary" style="margin-top: 0.75rem;">+ Agregar línea</button>

    <div style="margin-top: 1.5rem;">
      <button class="btn" type="submit"><%= batch ? 'Guardar cambios' : 'Registrar movimiento' %></button>
      <a class="btn secondary" href="<%= batch ? `/inventario/movimientos/lote/${batch.id}` : '/inventario/movimientos' %>">Cancelar</a>
    </div>
  </form>
</div>

<script>
  const ITEM_UNIT_OPTIONS = <%- JSON.stringify(itemUnitOptions) %>;
  const ITEMS = <%- JSON.stringify(items) %>;
  const EXISTING_LINES = <%- JSON.stringify(existingLines || []) %>;

  const typeSelect = document.getElementById('type');
  const traspasoOption = document.getElementById('traspaso-option');
  const singleWarehouseField = document.getElementById('single-warehouse-field');
  const fromWarehouseField = document.getElementById('from-warehouse-field');
  const toWarehouseField = document.getElementById('to-warehouse-field');
  const warehouseSelect = document.getElementById('warehouse_id');
  const fromWarehouseSelect = document.getElementById('from_warehouse_id');
  const toWarehouseSelect = document.getElementById('to_warehouse_id');
  const itemsBody = document.getElementById('items-body');
  const addRowBtn = document.getElementById('add-row-btn');

  let rowIndex = 0;

  function isTraspaso() {
    return typeSelect.value === 'traspaso';
  }

  function toggleWarehouseFields() {
    const transfer = isTraspaso();
    singleWarehouseField.style.display = transfer ? 'none' : '';
    fromWarehouseField.style.display = transfer ? '' : 'none';
    toWarehouseField.style.display = transfer ? '' : 'none';
    warehouseSelect.required = !transfer;
    fromWarehouseSelect.required = transfer;
    toWarehouseSelect.required = transfer;
  }

  function searchableItems() {
    return isTraspaso() ? ITEMS.filter((it) => it.type === 'product') : ITEMS;
  }

  function rowTemplate(index) {
    return `
      <tr class="item-row">
        <td class="item-number"></td>
        <td style="position: relative;">
          <input type="text" class="item-search" placeholder="Buscar por SKU/código o nombre..." autocomplete="off">
          <input type="hidden" class="item-type-input" name="items[${index}][item_type]">
          <input type="hidden" class="item-id-input" name="items[${index}][item_id]">
          <div class="item-selected-detail muted" style="font-size: 0.8rem; margin-top: 0.25rem;"></div>
          <div class="suggestions-list item-suggestions"></div>
        </td>
        <td><input type="number" class="qty-input" name="items[${index}][quantity]" min="0.0001" step="any"></td>
        <td>
          <select class="unit-select" name="items[${index}][unit_id]">
            <option value="">—</option>
          </select>
        </td>
        <td><button type="button" class="btn danger remove-row" style="padding: 0.3rem 0.55rem;">✕</button></td>
      </tr>
    `;
  }

  function renumberRows() {
    document.querySelectorAll('#items-body .item-row').forEach((row, i) => {
      row.querySelector('.item-number').textContent = i + 1;
    });
  }

  function populateUnitsForRow(row) {
    const typeInput = row.querySelector('.item-type-input');
    const idInput = row.querySelector('.item-id-input');
    const unitSelect = row.querySelector('.unit-select');
    const key = `${typeInput.value}:${idInput.value}`;
    const options = ITEM_UNIT_OPTIONS[key];

    unitSelect.innerHTML = '';
    if (!options || options.length === 0) {
      unitSelect.innerHTML = '<option value="">—</option>';
      return;
    }
    options.forEach((opt) => {
      const el = document.createElement('option');
      el.value = opt.unitId;
      el.textContent = opt.unitName;
      unitSelect.appendChild(el);
    });
  }

  function positionSuggestions(row) {
    const search = row.querySelector('.item-search');
    const suggestions = row.querySelector('.item-suggestions');
    const rect = search.getBoundingClientRect();
    suggestions.style.position = 'fixed';
    suggestions.style.top = `${rect.bottom + 4}px`;
    suggestions.style.left = `${rect.left}px`;
    suggestions.style.width = `${rect.width}px`;
    suggestions.style.right = 'auto';
    suggestions.style.marginTop = '0';
  }

  function renderRowSuggestions(row, matches) {
    const suggestions = row.querySelector('.item-suggestions');
    suggestions.innerHTML = '';

    if (matches.length === 0) {
      suggestions.style.display = 'none';
      return;
    }

    positionSuggestions(row);

    matches.slice(0, 8).forEach((it) => {
      const div = document.createElement('div');
      div.className = 'suggestion-item';
      const typeLabel = it.type === 'product' ? 'Producto' : 'Suministro';

      const main = document.createElement('div');
      main.textContent = `[${typeLabel}] ${it.sku} — ${it.name} (stock: ${it.quantity})`;
      div.appendChild(main);

      if (it.detail) {
        const detail = document.createElement('div');
        detail.className = 'suggestion-detail';
        detail.textContent = it.detail;
        div.appendChild(detail);
      }

      div.addEventListener('mousedown', (e) => {
        e.preventDefault();
        row.querySelector('.item-type-input').value = it.type;
        row.querySelector('.item-id-input').value = it.id;
        row.querySelector('.item-search').value = `[${typeLabel}] ${it.sku} — ${it.name}`;
        row.querySelector('.item-selected-detail').textContent = it.detail || '';
        suggestions.style.display = 'none';
        populateUnitsForRow(row);
      });
      suggestions.appendChild(div);
    });

    suggestions.style.display = 'block';
  }

  function attachRowListeners(row) {
    const search = row.querySelector('.item-search');
    const typeInput = row.querySelector('.item-type-input');
    const idInput = row.querySelector('.item-id-input');

    search.addEventListener('input', () => {
      typeInput.value = '';
      idInput.value = '';
      row.querySelector('.item-selected-detail').textContent = '';
      populateUnitsForRow(row);
      const q = search.value.trim().toLowerCase();
      renderRowSuggestions(row, q ? searchableItems().filter((it) => it.searchText.includes(q)) : []);
    });

    search.addEventListener('focus', () => {
      const q = search.value.trim().toLowerCase();
      if (q) renderRowSuggestions(row, searchableItems().filter((it) => it.searchText.includes(q)));
    });

    row.querySelector('.remove-row').addEventListener('click', () => {
      row.remove();
      renumberRows();
    });
  }

  function addRow() {
    const temp = document.createElement('tbody');
    temp.innerHTML = rowTemplate(rowIndex++);
    const newRow = temp.firstElementChild;
    itemsBody.appendChild(newRow);
    attachRowListeners(newRow);
    renumberRows();
  }

  document.addEventListener('click', (e) => {
    document.querySelectorAll('.item-suggestions').forEach((s) => {
      if (!s.parentElement.contains(e.target)) s.style.display = 'none';
    });
  });

  function repositionVisibleSuggestions() {
    document.querySelectorAll('#items-body .item-row').forEach((row) => {
      const suggestions = row.querySelector('.item-suggestions');
      if (suggestions.style.display === 'block') positionSuggestions(row);
    });
  }

  document.getElementById('items-table-wrapper').addEventListener('scroll', repositionVisibleSuggestions);
  window.addEventListener('scroll', repositionVisibleSuggestions, true);
  window.addEventListener('resize', repositionVisibleSuggestions);

  document.getElementById('movement-form').addEventListener('submit', (e) => {
    const rows = document.querySelectorAll('#items-body .item-row');
    const withItem = Array.from(rows).filter((row) => row.querySelector('.item-id-input').value);
    if (withItem.length === 0) {
      e.preventDefault();
      alert('Agrega al menos un producto o suministro con su cantidad.');
    }
  });

  addRowBtn.addEventListener('click', addRow);
  typeSelect.addEventListener('change', () => {
    toggleWarehouseFields();
    document.querySelectorAll('#items-body .item-row').forEach((row) => {
      row.querySelector('.item-suggestions').style.display = 'none';
    });
  });

  toggleWarehouseFields();

  if (EXISTING_LINES.length > 0) {
    EXISTING_LINES.forEach((line) => {
      addRow();
      const row = itemsBody.lastElementChild;
      row.querySelector('.item-type-input').value = line.itemType;
      row.querySelector('.item-id-input').value = line.itemId;
      row.querySelector('.item-search').value = line.label;
      row.querySelector('.item-selected-detail').textContent = line.detail || '';
      populateUnitsForRow(row);
      row.querySelector('.unit-select').value = line.unitId;
      row.querySelector('.qty-input').value = line.quantity;
    });
  } else {
    addRow();
  }
</script>

<%- include('../partials/footer') %>
