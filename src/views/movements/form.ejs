<%- include('../partials/header', { currentPage: 'movements' }) %>

<h1>Nuevo movimiento</h1>

<% if (query.error) { %>
  <div class="alert error"><%= query.error %></div>
<% } %>

<div class="card">
  <form method="post" action="/inventario/movimientos">
    <div class="form-grid">
      <div class="field" style="position: relative;">
        <label for="item_search">Producto o suministro</label>
        <input type="text" id="item_search" placeholder="Buscar por SKU/código o nombre..." autocomplete="off" required>
        <input type="hidden" id="item_type" name="item_type">
        <input type="hidden" id="item_id" name="item_id">
        <div id="item_suggestions" class="suggestions-list"></div>
      </div>
      <div class="field">
        <label for="type">Tipo de movimiento</label>
        <select id="type" name="type" required>
          <option value="in">Entrada</option>
          <option value="out">Salida</option>
          <option value="traspaso" id="traspaso-option">Traspaso entre bodegas</option>
        </select>
      </div>
      <div class="field">
        <label for="quantity">Cantidad</label>
        <input type="number" id="quantity" name="quantity" min="0.0001" step="any" required>
      </div>
      <div class="field">
        <label for="unit_id">Unidad de la cantidad</label>
        <select id="unit_id" name="unit_id" required>
          <option value="">Selecciona un elemento primero</option>
        </select>
      </div>
    </div>

    <div id="single-warehouse-field" class="form-grid" style="margin-bottom: 1rem;">
      <div class="field">
        <label for="warehouse_id">Bodega</label>
        <select id="warehouse_id" name="warehouse_id">
          <option value="">Selecciona una bodega</option>
          <% warehouses.forEach(w => { %>
            <option value="<%= w.id %>"><%= w.name %></option>
          <% }) %>
        </select>
      </div>
    </div>

    <div id="transfer-warehouse-fields" class="form-grid" style="margin-bottom: 1rem; display: none;">
      <div class="field">
        <label for="from_warehouse_id">Bodega origen</label>
        <select id="from_warehouse_id" name="from_warehouse_id">
          <option value="">Selecciona una bodega</option>
          <% warehouses.forEach(w => { %>
            <option value="<%= w.id %>"><%= w.name %></option>
          <% }) %>
        </select>
      </div>
      <div class="field">
        <label for="to_warehouse_id">Bodega destino</label>
        <select id="to_warehouse_id" name="to_warehouse_id">
          <option value="">Selecciona una bodega</option>
          <% warehouses.forEach(w => { %>
            <option value="<%= w.id %>"><%= w.name %></option>
          <% }) %>
        </select>
      </div>
    </div>

    <div class="field" style="margin-bottom: 1rem;">
      <label for="reason">Motivo</label>
      <input type="text" id="reason" name="reason" placeholder="Ej: compra a proveedor, venta, ajuste...">
    </div>

    <p id="equivalence-hint" class="empty" style="padding: 0; text-align: left; display: none;"></p>

    <button class="btn" type="submit">Registrar movimiento</button>
    <a class="btn secondary" href="/inventario/movimientos">Cancelar</a>
  </form>
</div>

<script>
  const ITEM_UNIT_OPTIONS = <%- JSON.stringify(itemUnitOptions) %>;
  const ITEMS = <%- JSON.stringify(items) %>;

  const itemTypeInput = document.getElementById('item_type');
  const itemIdInput = document.getElementById('item_id');
  const itemSearch = document.getElementById('item_search');
  const itemSuggestions = document.getElementById('item_suggestions');
  const typeSelect = document.getElementById('type');
  const traspasoOption = document.getElementById('traspaso-option');
  const unitSelect = document.getElementById('unit_id');
  const quantityInput = document.getElementById('quantity');
  const hint = document.getElementById('equivalence-hint');

  const singleWarehouseField = document.getElementById('single-warehouse-field');
  const transferWarehouseFields = document.getElementById('transfer-warehouse-fields');
  const warehouseSelect = document.getElementById('warehouse_id');
  const fromWarehouseSelect = document.getElementById('from_warehouse_id');
  const toWarehouseSelect = document.getElementById('to_warehouse_id');

  function currentOptionsKey() {
    return `${itemTypeInput.value}:${itemIdInput.value}`;
  }

  function populateUnits() {
    const options = ITEM_UNIT_OPTIONS[currentOptionsKey()];
    unitSelect.innerHTML = '';

    if (!options || options.length === 0) {
      unitSelect.innerHTML = '<option value="">Sin unidades disponibles</option>';
      unitSelect.required = false;
      updateHint();
      return;
    }

    options.forEach((opt) => {
      const el = document.createElement('option');
      el.value = opt.unitId;
      el.textContent = opt.unitName;
      el.dataset.factor = opt.factor;
      unitSelect.appendChild(el);
    });
    unitSelect.required = true;
    updateHint();
  }

  function updateHint() {
    const options = ITEM_UNIT_OPTIONS[currentOptionsKey()] || [];
    const selected = options.find((o) => String(o.unitId) === unitSelect.value);
    const qty = parseFloat(quantityInput.value);

    if (!selected || selected.factor === 1 || !qty) {
      hint.style.display = 'none';
      return;
    }

    const baseUnit = options.find((o) => o.factor === 1);
    const converted = qty * selected.factor;
    hint.textContent = `Equivale a ${converted} ${baseUnit ? baseUnit.unitName : ''} en stock.`;
    hint.style.display = 'block';
  }

  function toggleWarehouseFields() {
    const isTransfer = typeSelect.value === 'traspaso';

    singleWarehouseField.style.display = isTransfer ? 'none' : 'grid';
    transferWarehouseFields.style.display = isTransfer ? 'grid' : 'none';

    warehouseSelect.required = !isTransfer;
    fromWarehouseSelect.required = isTransfer;
    toWarehouseSelect.required = isTransfer;
  }

  function updateTraspasoAvailability() {
    const isSupply = itemTypeInput.value === 'supply';
    traspasoOption.disabled = isSupply;
    if (isSupply && typeSelect.value === 'traspaso') {
      typeSelect.value = 'in';
      toggleWarehouseFields();
    }
  }

  function renderSuggestions(matches) {
    itemSuggestions.innerHTML = '';

    if (matches.length === 0) {
      itemSuggestions.style.display = 'none';
      return;
    }

    matches.slice(0, 8).forEach((it) => {
      const row = document.createElement('div');
      row.className = 'suggestion-item';

      const main = document.createElement('div');
      const typeLabel = it.type === 'product' ? 'Producto' : 'Suministro';
      main.textContent = `[${typeLabel}] ${it.sku} — ${it.name} (stock: ${it.quantity})`;
      row.appendChild(main);

      if (it.detail) {
        const detail = document.createElement('div');
        detail.className = 'suggestion-detail';
        detail.textContent = it.detail;
        row.appendChild(detail);
      }

      row.addEventListener('mousedown', (e) => {
        e.preventDefault();
        selectItem(it);
      });
      itemSuggestions.appendChild(row);
    });

    itemSuggestions.style.display = 'block';
  }

  function searchItems(query) {
    const q = query.trim().toLowerCase();
    if (!q) return [];
    return ITEMS.filter((it) => it.searchText.includes(q));
  }

  function selectItem(it) {
    itemTypeInput.value = it.type;
    itemIdInput.value = it.id;
    const typeLabel = it.type === 'product' ? 'Producto' : 'Suministro';
    itemSearch.value = `[${typeLabel}] ${it.sku} — ${it.name}`;
    itemSearch.style.borderColor = '';
    itemSuggestions.style.display = 'none';
    updateTraspasoAvailability();
    populateUnits();
  }

  itemSearch.addEventListener('input', () => {
    itemTypeInput.value = '';
    itemIdInput.value = '';
    renderSuggestions(searchItems(itemSearch.value));
    updateTraspasoAvailability();
    populateUnits();
  });

  itemSearch.addEventListener('focus', () => {
    if (itemSearch.value.trim()) {
      renderSuggestions(searchItems(itemSearch.value));
    }
  });

  document.addEventListener('click', (e) => {
    if (e.target !== itemSearch) {
      itemSuggestions.style.display = 'none';
    }
  });

  document.querySelector('form').addEventListener('submit', (e) => {
    if (!itemTypeInput.value || !itemIdInput.value) {
      e.preventDefault();
      itemSearch.style.borderColor = 'var(--danger)';
      itemSearch.focus();
    }
  });

  unitSelect.addEventListener('change', updateHint);
  quantityInput.addEventListener('input', updateHint);
  typeSelect.addEventListener('change', toggleWarehouseFields);

  populateUnits();
  toggleWarehouseFields();
</script>

<%- include('../partials/footer') %>
