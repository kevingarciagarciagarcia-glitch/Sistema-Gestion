<%- include('../partials/header', { currentPage: 'movements' }) %>

<div class="toolbar">
  <h1 style="margin: 0;">Movimiento de Stock #<%= movement.id %></h1>
  <div style="display: flex; gap: 0.5rem;">
    <button type="button" class="btn secondary" onclick="window.print()">🖨 Imprimir</button>
    <a class="btn secondary" href="/inventario/movimientos">Volver</a>
  </div>
</div>

<div class="card" id="print-area">
  <div class="form-grid" style="margin-bottom: 1.5rem;">
    <div><span class="muted">Fecha</span><br><strong><%= movement.created_at %></strong></div>
    <div>
      <span class="muted">Tipo</span><br>
      <span class="badge <%= movement.type %>">
        <%= movement.type === 'in' ? 'Entrada' : movement.type === 'out' ? 'Salida' : 'Traspaso' %>
      </span>
    </div>
    <div><span class="muted">Producto</span><br><strong><%= movement.item_code %> — <%= movement.item_name %></strong></div>
    <div><span class="muted">Categoría</span><br><strong><%= movement.category_name || '—' %></strong></div>
    <div>
      <span class="muted">Cantidad</span><br>
      <strong>
        <% if (movement.input_unit_id && Number(movement.input_unit_id) !== Number(movement.item_unit_id)) { %>
          <%= movement.input_quantity %> <%= movement.input_unit_name %> (= <%= movement.quantity %> <%= movement.unit_name || '—' %>)
        <% } else { %>
          <%= movement.quantity %> <%= movement.unit_name || '—' %>
        <% } %>
      </strong>
    </div>
    <div>
      <span class="muted">Bodega</span><br>
      <strong>
        <% if (movement.type === 'traspaso') { %>
          <%= movement.from_warehouse_name || '—' %> → <%= movement.to_warehouse_name || '—' %>
        <% } else { %>
          <%= movement.warehouse_name || '—' %>
        <% } %>
      </strong>
    </div>
    <div><span class="muted">Motivo</span><br><strong><%= movement.reason || '—' %></strong></div>
  </div>

  <% if (showDimensions) { %>
    <h2 style="font-size: 1rem; margin-bottom: 0.75rem;">Dimensiones</h2>
    <div class="form-grid" style="margin-bottom: 1.5rem;">
      <div><span class="muted">Color</span><br><strong><%= movement.color || '—' %></strong></div>
      <div><span class="muted">Ancho</span><br><strong><%= movement.width ?? '—' %></strong></div>
      <div><span class="muted">Largo</span><br><strong><%= movement.length ?? '—' %></strong></div>
      <div><span class="muted">Espesor</span><br><strong><%= movement.thickness ?? '—' %></strong></div>
      <div>
        <span class="muted">Fuelle</span><br>
        <strong>
          <% if (!movement.has_fuelle) { %>—<%
            } else if (movement.fuelle_type === 'lateral') { %>Lateral: <%= movement.fuelle_measure_1 ?? '—' %><%
            } else if (movement.fuelle_type === 'fondo') { %>Fondo: <%= movement.fuelle_measure_1 ?? '—' %><%
            } else { %>Superior: <%= movement.fuelle_measure_1 ?? '—' %> / Fondo: <%= movement.fuelle_measure_2 ?? '—' %><%
          } %>
        </strong>
      </div>
    </div>
  <% } %>

  <% if (showPrinting) { %>
    <h2 style="font-size: 1rem; margin-bottom: 0.75rem;">Impresión</h2>
    <div class="form-grid" style="margin-bottom: 1.5rem;">
      <div><span class="muted">Tipo</span><br><strong><%= movement.printing_type === 'serigrafia' ? 'Serigrafía' : 'Flexografía' %></strong></div>
      <div>
        <span class="muted">Lado</span><br>
        <strong>
          <% if (movement.printing_side === 'anverso') { %>Anverso<%
            } else if (movement.printing_side === 'reverso') { %>Reverso<%
            } else { %>Anverso y reverso<%
          } %>
        </strong>
      </div>
      <div><span class="muted">Referencia</span><br><strong><%= movement.printing_reference || '—' %></strong></div>
      <div><span class="muted">Cantidad de colores</span><br><strong><%= movement.printing_colors ?? '—' %></strong></div>
    </div>
  <% } %>

  <% if (showSpecs) { %>
    <h2 style="font-size: 1rem; margin-bottom: 0.75rem;">Especificaciones</h2>
    <div class="form-grid" style="margin-bottom: 1.5rem;">
      <div><span class="muted">Código</span><br><strong><%= movement.spec_code || '—' %></strong></div>
      <div><span class="muted">Marca</span><br><strong><%= movement.spec_brand || '—' %></strong></div>
      <div><span class="muted">Presentación</span><br><strong><%= movement.spec_presentation || '—' %></strong></div>
    </div>
  <% } %>

  <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; margin-top: 3rem;">
    <div style="text-align: center;">
      <div style="border-top: 1px solid var(--text); padding-top: 0.5rem;">
        <strong><%= movement.created_by_full_name || movement.created_by_username || '—' %></strong>
      </div>
      <div class="muted">Elaborado por</div>
    </div>
    <div style="text-align: center;">
      <div style="border-top: 1px solid var(--text); padding-top: 0.5rem;">&nbsp;</div>
      <div class="muted">Aprobado por</div>
    </div>
    <div style="text-align: center;">
      <div style="border-top: 1px solid var(--text); padding-top: 0.5rem;">&nbsp;</div>
      <div class="muted">Recibido por</div>
    </div>
  </div>
</div>

<style>
  @media print {
    header.topbar, .toolbar, .sidebar, .sidebar-open-btn { display: none !important; }
    main { padding: 0; max-width: none; }
    #print-area { border: none; }
  }
</style>

<%- include('../partials/footer') %>
