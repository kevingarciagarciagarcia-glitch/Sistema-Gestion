<%- include('../partials/logistics-header', { currentPage: 'logistica' }) %>

<h1>Logística · Despacho de Órdenes</h1>

<% if (query.error) { %>
  <div class="alert error"><%= query.error %></div>
<% } %>

<div class="stats-grid">
  <div class="stat-card">
    <div class="label">Pendientes</div>
    <div class="value"><%= kpis.pendiente %></div>
  </div>
  <div class="stat-card">
    <div class="label">Parciales</div>
    <div class="value"><%= kpis.parcial %></div>
  </div>
  <div class="stat-card">
    <div class="label">Completas</div>
    <div class="value"><%= kpis.completo %></div>
  </div>
  <div class="stat-card">
    <div class="label">Con saldo pendiente</div>
    <div class="value"><%= kpis.conSaldo %></div>
  </div>
</div>

<div class="card">
  <form method="get" action="/logistica" class="form-grid" style="align-items: end;">
    <div class="field" style="margin-bottom: 0;">
      <label for="q">Buscar por N° orden o SKU</label>
      <input type="text" id="q" name="q" value="<%= filters.q %>" placeholder="Ej: 7 o SER-013">
    </div>
    <div class="field" style="margin-bottom: 0;">
      <label for="cliente">Cliente</label>
      <input type="text" id="cliente" name="cliente" value="<%= filters.cliente %>" placeholder="Nombre del cliente">
    </div>
    <div class="field" style="margin-bottom: 0;">
      <label for="estado">Estado</label>
      <select id="estado" name="estado">
        <option value="">Todos</option>
        <option value="pendiente" <%= filters.estado === 'pendiente' ? 'selected' : '' %>>Pendiente</option>
        <option value="parcial" <%= filters.estado === 'parcial' ? 'selected' : '' %>>Parcial</option>
        <option value="completo" <%= filters.estado === 'completo' ? 'selected' : '' %>>Completo</option>
      </select>
    </div>
    <div class="field" style="margin-bottom: 0;">
      <label for="from">Fecha pedido desde</label>
      <input type="date" id="from" name="from" value="<%= filters.from %>">
    </div>
    <div class="field" style="margin-bottom: 0;">
      <label for="to">Fecha pedido hasta</label>
      <input type="date" id="to" name="to" value="<%= filters.to %>">
    </div>
    <div class="field" style="margin-bottom: 0;">
      <button class="btn" type="submit">Filtrar</button>
    </div>
  </form>
</div>

<div class="card">
  <% if (orders.length === 0) { %>
    <p class="empty">No hay órdenes de pedido que coincidan con los filtros.</p>
  <% } else { %>
    <div style="overflow-x: auto;">
    <table>
      <thead>
        <tr>
          <th>N° OP</th><th>Cliente</th><th>Fecha Pedido</th><th>Fecha Entrega</th>
          <th>Pedido</th><th>Despachado</th><th>Saldo</th><th>Avance</th><th>Estado</th><th></th>
        </tr>
      </thead>
      <tbody>
        <% orders.forEach(o => { %>
          <tr class="<%= o.status !== 'completo' ? 'needs-dispatch-row' : '' %>">
            <td><strong>#<%= o.id %></strong></td>
            <td><%= o.client %></td>
            <td><%= o.order_date || '—' %></td>
            <td><%= o.delivery_date || '—' %></td>
            <td><%= o.totalRequested %></td>
            <td><%= o.totalDispatched %></td>
            <td><%= o.pendingBalance %></td>
            <td style="min-width: 140px;">
              <div class="progress-track">
                <div class="progress-fill <%= o.status %>" style="width: <%= o.progressPct %>%;"></div>
              </div>
              <span class="muted" style="font-size: 0.78rem;"><%= o.progressPct %>%</span>
            </td>
            <td><span class="badge <%= o.status %>"><%= STATUS_LABELS[o.status] %></span></td>
            <td class="actions-cell">
              <a class="btn secondary" href="/logistica/<%= o.id %>">Gestionar despacho</a>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
    </div>
  <% } %>
</div>

<style>
  .needs-dispatch-row { background: #fffbeb; }
  .progress-track { background: var(--bg); border-radius: 999px; height: 8px; overflow: hidden; margin-bottom: 0.2rem; }
  .progress-fill { height: 100%; border-radius: 999px; }
  .progress-fill.pendiente { background: var(--muted); }
  .progress-fill.parcial { background: var(--warning); }
  .progress-fill.completo { background: var(--success); }
  .badge.pendiente { background: #fee2e2; color: var(--danger); }
  .badge.parcial { background: #fef3c7; color: var(--warning); }
  .badge.completo { background: #dcfce7; color: var(--success); }
</style>

<%- include('../partials/footer') %>
