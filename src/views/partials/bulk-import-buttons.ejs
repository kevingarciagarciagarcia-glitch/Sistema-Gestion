<a class="btn secondary" href="<%= templateUrl %>">⬇ Plantilla Excel</a>
<form method="post" action="<%= importUrl %>" enctype="multipart/form-data" style="display: flex; gap: 0.4rem; align-items: center; margin: 0;">
  <input type="file" name="file" accept=".xlsx" required style="width: 220px; font-size: 0.85rem;">
  <button class="btn secondary" type="submit">⬆ Importar</button>
</form>
