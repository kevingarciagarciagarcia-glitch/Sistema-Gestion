<%- include('../partials/orders-header', { currentPage: 'orders' }) %>

<div class="toolbar">
  <h1 style="margin: 0;">Orden de Pedido #<%= order.id %></h1>
  <div style="display: flex; gap: 0.5rem;">
    <button type="button" class="btn secondary" onclick="window.print()">🖨 Imprimir</button>
    <% if (hasPermission('ordenes', 'modificar')) { %>
      <a class="btn secondary" href="/pedidos/<%= order.id %>/edit">Editar</a>
    <% } %>
    <a class="btn secondary" href="/pedidos">Volver</a>
  </div>
</div>

<div class="card">
  <div class="form-grid" style="margin-bottom: 1.5rem;">
    <div><span class="muted">Cliente</span><br><strong><%= order.client %></strong></div>
    <div><span class="muted">N° Proforma</span><br><strong><%= order.proforma_number || '—' %></strong></div>
    <div><span class="muted">Fecha de Pedido</span><br><strong><%= order.order_date || '—' %></strong></div>
    <div><span class="muted">Fecha de Entrega</span><br><strong><%= order.delivery_date || '—' %></strong></div>
    <div><span class="muted">Ciudad</span><br><strong><%= order.city || '—' %></strong></div>
    <div><span class="muted">Sucursal</span><br><strong><%= order.branch || '—' %></strong></div>
    <div><span class="muted">Vendedor</span><br><strong><%= seller?.name || '—' %></strong></div>
  </div>

  <div style="overflow-x: auto;">
  <table>
    <thead>
      <tr>
        <th>N°</th><th>Tipo</th><th>Producto</th><th>Color</th><th>A</th><th>L</th><th>E</th>
        <th>Cantidad</th><th>Total Kg</th><th>Precio U</th><th>Precio Total</th>
      </tr>
    </thead>
    <tbody>
      <% const typeLabels = { rollo: 'Rollo', funda: 'Funda', lamina: 'Lámina' }; %>
      <% order.items.forEach(it => { %>
        <tr>
          <td><%= it.item_number %></td>
          <td><%= typeLabels[it.type] || it.type %></td>
          <td><%= it.product %></td>
          <td><%= it.color || '—' %></td>
          <td><%= it.width ?? '—' %></td>
          <td><%= it.length ?? '—' %></td>
          <td><%= it.thickness ?? '—' %></td>
          <td><%= it.quantity %></td>
          <td><%= it.total_kg ?? '—' %></td>
          <td>$<%= it.unit_price.toFixed(2) %></td>
          <td>$<%= it.line_total.toFixed(2) %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  </div>

  <div style="text-align: right; margin-top: 1rem; font-size: 1.1rem;">
    Subtotal: <strong>$<%= order.subtotal.toFixed(2) %></strong>
  </div>
</div>

<style>
  @media print {
    header.topbar, .toolbar, .sidebar, .sidebar-open-btn { display: none !important; }
    main { padding: 0; max-width: none; }
  }
</style>

<%- include('../partials/footer') %>
