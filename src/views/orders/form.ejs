  const COLORS = <%- JSON.stringify(colors) %>;
  const NEXT_CODE_BY_CATEGORY = <%- JSON.stringify(nextCodeByCategory) %>;
  const MAX_PRINTING_COLORS = 10;
  const usedCodeCounts = {};

  function toggleCmFuelle() { cmFuelleFields.style.display = cmHasFuelle.checked ? 'grid' : 'none'; }
  function toggleCmFuelleMeasure2() { cmFuelleMeasure2Field.style.display = cmFuelleType.value === 'superior_fondo' ? '' : 'none'; }
  function toggleCmPrinting() {
    cmPrintingFields.style.display = cmHasPrinting.checked ? 'grid' : 'none';
    renderCmPrintingColorSlots();
  }

  function parseCodeParts(code) {
    const m = /^(.*?)(\d+)$/.exec(String(code || ''));
    if (!m) return null;
    return { prefix: m[1], number: parseInt(m[2], 10), width: m[2].length };
  }

  function updateCmCode() {
    const categoryId = cmCategory.value;
    const baseCode = categoryId ? NEXT_CODE_BY_CATEGORY[categoryId] : null;
    if (!baseCode) {
      cmCode.value = '';
      cmCode.placeholder = categoryId ? 'Sin productos previos en esta categoría' : 'Selecciona una categoría';
      return;
    }
    const parts = parseCodeParts(baseCode);
    const used = usedCodeCounts[categoryId] || 0;
    cmCode.value = parts ? `${parts.prefix}${String(parts.number + used).padStart(parts.width, '0')}` : baseCode;
  }

  cmCategory.addEventListener('change', updateCmCode);
  cmSaveToInventory.addEventListener('change', () => {
    cmUnitField.style.display = cmSaveToInventory.checked ? '' : 'none';
  });
  cmHasFuelle.addEventListener('change', toggleCmFuelle);
  cmFuelleType.addEventListener('change', toggleCmFuelleMeasure2);
  cmHasPrinting.addEventListener('change', toggleCmPrinting);
  cmPrintingColors.addEventListener('input', () => renderCmPrintingColorSlots());

  function renderCmPrintingColorSlots(existingColors) {
    const count = Math.min(Math.max(parseInt(cmPrintingColors.value, 10) || 0, 0), MAX_PRINTING_COLORS);
    const previous = existingColors || getCmPrintingColorSelections();
    cmPrintingColorSlots.innerHTML = '';

    if (!cmHasPrinting.checked || count === 0) {
      cmPrintingColorSlots.style.display = 'none';
      return;
    }

    for (let i = 1; i <= count; i++) {
      const field = document.createElement('div');
      field.className = 'field';

      const label = document.createElement('label');
      label.textContent = `Color ${i}`;
      field.appendChild(label);

      if (COLORS.length === 0) {
        const empty = document.createElement('p');
        empty.className = 'muted';
        empty.textContent = 'Todavía no hay colores en la paleta. Agrega colores desde Inventario → Colores.';
        field.appendChild(empty);
      } else {
        const picker = document.createElement('div');
        picker.className = 'color-palette-picker';
        const existing = previous[i - 1] || '';

        COLORS.forEach((c) => {
          const optionLabel = document.createElement('label');
          optionLabel.className = 'color-swatch-option';

          const input = document.createElement('input');
          input.type = 'radio';
          input.name = `cm_printing_color_${i}`;
          input.value = c.name;
          if (existing && existing.toLowerCase() === c.name.toLowerCase()) input.checked = true;

          const swatch = document.createElement('span');
          swatch.className = 'color-swatch';
          swatch.style.background = c.hex || '#ccc';

          optionLabel.appendChild(input);
          optionLabel.appendChild(swatch);
          optionLabel.appendChild(document.createTextNode(c.name));
          picker.appendChild(optionLabel);
        });

        field.appendChild(picker);
      }

      cmPrintingColorSlots.appendChild(field);
    }

    cmPrintingColorSlots.style.display = 'block';
  }

  function getCmPrintingColorSelections() {
    const count = Math.min(Math.max(parseInt(cmPrintingColors.value, 10) || 0, 0), MAX_PRINTING_COLORS);
    const names = [];
    for (let i = 1; i <= count; i++) {
      const checked = cmPrintingColorSlots.querySelector(`input[name="cm_printing_color_${i}"]:checked`);
      if (checked) names.push(checked.value);
    }
    return names;
  }

  function resetCustomModal() {
    cmProduct.value = '';
    cmCategory.value = '';
    cmCode.value = '';
    cmCode.placeholder = 'Selecciona una categoría';
    cmSaveToInventory.checked = false;
    cmUnitField.style.display = 'none';
    cmUnit.value = '';
    cmWidth.value = ''; cmLength.value = ''; cmThickness.value = '';
    if (cmColorPicker) cmColorPicker.querySelectorAll('input[type="radio"]').forEach((r) => { r.checked = false; });
    cmHasFuelle.checked = false;
    cmFuelleType.value = ''; cmFuelleMeasure1.value = ''; cmFuelleMeasure2.value = '';
    cmHasPrinting.checked = false;
    cmPrintingType.value = ''; cmPrintingSide.value = ''; cmPrintingColors.value = ''; cmPrintingReference.value = '';
    toggleCmFuelle(); toggleCmFuelleMeasure2(); toggleCmPrinting();
  }

  function fillCustomModalFromRow(row) {
    cmProduct.value = row.querySelector('.product-name-input').value;
    cmCategory.value = '';
    cmCode.value = row.querySelector('.product-code-input').value || '';
    cmSaveToInventory.checked = false;
    cmUnitField.style.display = 'none';
    cmUnit.value = '';
    cmWidth.value = row.querySelector('.width-input').value;
    cmLength.value = row.querySelector('.length-input').value;
    cmThickness.value = row.querySelector('.thickness-input').value;
    const color = row.querySelector('.color-input').value;
    if (cmColorPicker && color) {
      const radio = cmColorPicker.querySelector(`input[value="${CSS.escape(color)}"]`);
      if (radio) radio.checked = true;
    }
    cmHasFuelle.checked = row.querySelector('.has-fuelle-input').value === '1';
    cmFuelleType.value = row.querySelector('.fuelle-type-input').value;
    cmFuelleMeasure1.value = row.querySelector('.fuelle-measure-1-input').value;
    cmFuelleMeasure2.value = row.querySelector('.fuelle-measure-2-input').value;
    cmHasPrinting.checked = row.querySelector('.has-printing-input').value === '1';
    cmPrintingType.value = row.querySelector('.printing-type-input').value;
    cmPrintingSide.value = row.querySelector('.printing-side-input').value;
    cmPrintingColors.value = row.querySelector('.printing-colors-input').value;
    cmPrintingReference.value = row.querySelector('.printing-reference-input').value;
    const existingPrintingColors = (row.querySelector('.printing-colors-text-input').value || '')
      .split('/').map((s) => s.trim()).filter(Boolean);
    toggleCmFuelle(); toggleCmFuelleMeasure2(); toggleCmPrinting();
    renderCmPrintingColorSlots(existingPrintingColors);
