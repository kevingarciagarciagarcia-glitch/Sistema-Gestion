<%- include('../partials/orders-header', { currentPage: 'orders' }) %>

<h1><%= order ? `Editar orden #${order.id}` : 'Nueva orden de pedido' %></h1>

<% if (query.error) { %>
  <div class="alert error" style="position: relative; padding-right: 2.5rem;">
    <button type="button" onclick="this.parentElement.remove()" aria-label="Cerrar"
      style="position: absolute; top: 0.5rem; right: 0.6rem; background: none; border: none; font-size: 1.1rem; line-height: 1; cursor: pointer; color: inherit; opacity: 0.7;">✕</button>
    <%= query.error %>
  </div>
<% } %>

<div class="card">
  <form method="post" action="<%= order ? `/pedidos/${order.id}` : '/pedidos' %>" id="order-form">
    <div id="order-form-error" class="alert error" style="display: none; position: relative; padding-right: 2.5rem;">
      <button type="button" id="order-form-error-close" aria-label="Cerrar"
        style="position: absolute; top: 0.5rem; right: 0.6rem; background: none; border: none; font-size: 1.1rem; line-height: 1; cursor: pointer; color: inherit; opacity: 0.7;">✕</button>
      <span id="order-form-error-text"></span>
    </div>
    <h2 style="margin-top: 0;">Datos de la orden</h2>
    <div class="form-grid">
      <div class="field" style="position: relative;">
        <label for="client_search">Cliente</label>
        <div style="display: flex; gap: 0.5rem;">
          <input type="text" id="client_search" name="client" placeholder="Buscar cliente o escribir nombre..." autocomplete="off" value="<%= order?.client || '' %>" required style="flex: 1;">
          <button type="button" class="btn secondary" id="new-client-btn" style="white-space: nowrap;">+ Nuevo</button>
        </div>
        <input type="hidden" id="client_id" name="client_id" value="<%= order?.client_id || '' %>">
        <div id="client_suggestions" class="suggestions-list"></div>
      </div>
      <div class="field">
        <label for="proforma_number">N° Proforma</label>
        <input type="text" id="proforma_number" name="proforma_number" value="<%= order?.proforma_number || '' %>">
      </div>
      <div class="field">
        <label for="order_date">Fecha de Pedido</label>
        <input type="date" id="order_date" name="order_date" value="<%= order?.order_date || '' %>">
      </div>
      <div class="field">
        <label for="delivery_date">Fecha de Entrega</label>
        <input type="date" id="delivery_date" name="delivery_date" value="<%= order?.delivery_date || '' %>">
      </div>
      <div class="field">
        <label for="city">Ciudad</label>
        <input type="text" id="city" name="city" value="<%= order?.city || '' %>">
      </div>
      <div class="field">
        <label for="branch">Sucursal</label>
        <input type="text" id="branch" name="branch" value="<%= order?.branch || '' %>">
      </div>
      <div class="field">
        <label for="seller_id">Vendedor</label>
        <select id="seller_id" name="seller_id" required>
          <option value="">Selecciona un vendedor</option>
          <% sellers.forEach(s => { %>
            <option value="<%= s.id %>" <%= order?.seller_id === s.id ? 'selected' : '' %>><%= s.name %></option>
          <% }) %>
        </select>
      </div>
    </div>

    <h2>Productos solicitados</h2>
    <div style="overflow-x: auto;" id="items-table-wrapper">
    <table>
      <thead>
        <tr>
          <th style="width: 2rem;">N°</th>
          <th style="width: 110px;">Tipo</th>
          <th style="min-width: 260px;">Producto</th>
          <th style="width: 90px;">Cantidad</th>
          <th style="width: 100px;">Fundas x Bulto</th>
          <th style="width: 100px;">Fundas x Paquete</th>
          <th style="width: 90px;">Total Kg</th>
          <th style="width: 100px;">Precio U</th>
          <th style="width: 100px;">Precio Total</th>
          <th style="width: 160px;">Observación</th>
          <th style="width: 2rem;"></th>
        </tr>
      </thead>
      <tbody id="items-body"></tbody>
    </table>
    </div>
    <button type="button" id="add-row-btn" class="btn secondary" style="margin-top: 0.75rem;">+ Agregar línea</button>

    <div style="text-align: right; margin: 1rem 0; font-size: 1.1rem;">
      Subtotal: <strong id="order-subtotal">$0.00</strong>
    </div>

    <button class="btn" type="submit">Guardar orden</button>
    <a class="btn secondary" href="/pedidos">Cancelar</a>
  </form>
</div>

<div id="client-modal-overlay" style="display: none; position: fixed; inset: 0; background: rgba(15, 23, 42, 0.5); z-index: 100; align-items: center; justify-content: center;">
  <div style="background: var(--card); border-radius: 10px; width: min(720px, 92vw); max-height: 88vh; display: flex; flex-direction: column; overflow: hidden;">
    <div style="display: flex; align-items: center; justify-content: space-between; padding: 1rem 1.25rem; border-bottom: 1px solid var(--border);">
      <strong>Nuevo cliente</strong>
      <button type="button" id="close-client-modal" class="btn secondary" style="padding: 0.3rem 0.6rem;">✕</button>
    </div>
    <iframe id="client-modal-iframe" src="about:blank" title="Nuevo cliente" style="border: 0; flex: 1; min-height: 560px;"></iframe>
  </div>
</div>

<div id="custom-item-modal-overlay" class="item-modal-overlay">
  <div class="item-modal">
    <div class="item-modal-header">
      <strong>Producto personalizado</strong>
      <button type="button" class="btn secondary" id="close-custom-modal" style="padding: 0.3rem 0.6rem;">✕</button>
    </div>
    <div class="item-modal-body">
      <div class="form-grid">
        <div class="field">
          <label for="cm_product">Producto</label>
          <input type="text" id="cm_product" placeholder="Nombre del producto">
        </div>
        <div class="field">
          <label for="cm_category">Categoría</label>
          <select id="cm_category">
            <option value="">Selecciona...</option>
            <% categories.forEach(c => { %>
              <option value="<%= c.id %>"><%= c.name %></option>
            <% }) %>
          </select>
        </div>
        <div class="field">
          <label for="cm_code">Código</label>
          <input type="text" id="cm_code" readonly placeholder="Selecciona una categoría" style="background: var(--bg); cursor: not-allowed;">
        </div>
        <div class="field" id="cm_unit_field" style="display: none;">
          <label for="cm_unit">Unidad de medida</label>
          <select id="cm_unit">
            <option value="">Selecciona...</option>
            <% units.forEach(u => { %>
              <option value="<%= u.id %>"><%= u.name %></option>
            <% }) %>
          </select>
        </div>
        <div class="field">
          <label for="cm_width">Ancho (A)</label>
          <input type="number" id="cm_width" step="any" min="0">
        </div>
        <div class="field">
          <label for="cm_length">Largo (L)</label>
          <input type="number" id="cm_length" step="any" min="0">
        </div>
        <div class="field">
          <label for="cm_thickness">Espesor (E)</label>
          <input type="number" id="cm_thickness" step="any" min="0">
        </div>
      </div>

      <div class="field" style="margin-bottom: 1rem;">
        <label>Color</label>
        <% if (colors.length === 0) { %>
          <p class="empty" style="padding: 0.5rem 0;">No hay colores en la paleta. Agrega colores desde Inventario → Colores.</p>
        <% } else { %>
          <div class="color-palette-picker" id="cm_color_picker">
            <% colors.forEach(c => { %>
              <label class="color-swatch-option">
                <input type="radio" name="cm_color" value="<%= c.name %>">
                <span class="color-swatch" style="background: <%= c.hex || '#ccc' %>;"></span>
                <%= c.name %>
              </label>
            <% }) %>
          </div>
        <% } %>
      </div>

      <div class="field" style="margin-bottom: 0.75rem;">
        <label style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0;">
          <input type="checkbox" id="cm_has_fuelle" style="width: auto;"> Lleva fuelle
        </label>
      </div>
      <div id="cm_fuelle_fields" class="form-grid" style="display: none; margin-bottom: 1rem;">
        <div class="field">
          <label for="cm_fuelle_type">Tipo de fuelle</label>
          <select id="cm_fuelle_type">
            <option value="">Selecciona...</option>
            <option value="lateral">Fuelle Lateral</option>
            <option value="fondo">Fuelle Fondo</option>
            <option value="superior_fondo">Fuelle Superior y Fondo</option>
          </select>
        </div>
        <div class="field">
          <label for="cm_fuelle_measure_1">Medida</label>
          <input type="number" id="cm_fuelle_measure_1" step="any" min="0">
        </div>
        <div class="field" id="cm_fuelle_measure_2_field" style="display: none;">
          <label for="cm_fuelle_measure_2">Medida fondo</label>
          <input type="number" id="cm_fuelle_measure_2" step="any" min="0">
        </div>
      </div>

      <div class="field" style="margin-bottom: 0.75rem;">
        <label style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0;">
          <input type="checkbox" id="cm_has_printing" style="width: auto;"> Lleva impresión
        </label>
      </div>
      <div id="cm_printing_fields" class="form-grid" style="display: none; margin-bottom: 0.5rem;">
        <div class="field">
          <label for="cm_printing_type">Tipo de impresión</label>
          <select id="cm_printing_type">
            <option value="">Selecciona...</option>
            <option value="serigrafia">Serigrafía</option>
            <option value="flexografia">Flexografía</option>
          </select>
        </div>
        <div class="field">
          <label for="cm_printing_side">Lado de impresión</label>
          <select id="cm_printing_side">
            <option value="">Selecciona...</option>
            <option value="anverso">Anverso</option>
            <option value="reverso">Reverso</option>
            <option value="anverso_reverso">Anverso y reverso</option>
          </select>
        </div>
        <div class="field">
          <label for="cm_printing_colors">Cantidad de colores</label>
          <input type="number" id="cm_printing_colors" min="1" step="1">
        </div>
        <div class="field">
          <label for="cm_printing_reference">Referencia</label>
          <input type="text" id="cm_printing_reference" placeholder="Ej: Supermaxi">
        </div>
      </div>
      <div id="cm_printing_color_slots" style="display: none; margin-bottom: 0.5rem;"></div>

      <div class="field" style="margin-bottom: 0;">
        <label style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0;">
          <input type="checkbox" id="cm_save_to_inventory" style="width: auto;"> Guardar este producto en mi inventario (Producto Terminado)
        </label>
      </div>
    </div>
    <div class="item-modal-footer">
      <button type="button" class="btn secondary" id="cancel-custom-modal">Cancelar</button>
      <button type="button" class="btn" id="save-custom-modal">Agregar a la línea</button>
    </div>
  </div>
</div>

<div id="product-modal-overlay" style="display: none; position: fixed; inset: 0; background: rgba(15, 23, 42, 0.5); z-index: 110; align-items: center; justify-content: center;">
  <div style="background: var(--card); border-radius: 10px; width: min(900px, 94vw); max-height: 92vh; display: flex; flex-direction: column; overflow: hidden;">
    <div style="display: flex; align-items: center; justify-content: space-between; padding: 1rem 1.25rem; border-bottom: 1px solid var(--border);">
      <strong>Crear producto en inventario</strong>
      <button type="button" id="close-product-modal" class="btn secondary" style="padding: 0.3rem 0.6rem;">✕</button>
    </div>
    <iframe id="product-modal-iframe" src="about:blank" title="Nuevo producto" style="border: 0; flex: 1; min-height: 640px;"></iframe>
  </div>
</div>

<style>
  .item-modal-overlay {
    display: none;
    position: fixed; inset: 0;
    background: rgba(15, 23, 42, 0.5);
    z-index: 100;
    align-items: center;
    justify-content: center;
  }

  .item-modal {
    background: var(--card);
    border-radius: 10px;
    width: min(680px, 92vw);
    max-height: 88vh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .item-modal-header {
    display: flex; align-items: center; justify-content: space-between;
    padding: 1rem 1.25rem; border-bottom: 1px solid var(--border);
  }

  .item-modal-body { padding: 1.25rem; overflow-y: auto; }

  .item-modal-footer {
    display: flex; justify-content: flex-end; gap: 0.5rem;
    padding: 1rem 1.25rem; border-top: 1px solid var(--border);
  }

  .product-chooser { display: flex; gap: 0.4rem; flex-wrap: wrap; }
  .product-chooser button { font-size: 0.8rem; padding: 0.35rem 0.6rem; white-space: nowrap; }

  .product-picked-name { font-weight: 600; font-size: 0.9rem; }
  .product-picked-detail { font-size: 0.78rem; color: var(--muted); margin-top: 0.15rem; }
  .product-picked-detail .color-swatch { width: 11px; height: 11px; }
  .btn-change-product { font-size: 0.75rem; padding: 0.15rem 0.4rem; margin-top: 0.3rem; }

  .field-error { border: 1px solid var(--danger) !important; background: #fef2f2 !important; border-radius: 6px; }
  td.field-error { padding: 0.4rem; }
  .field-error-message { color: var(--danger); font-size: 0.75rem; margin-top: 0.25rem; }
</style>

<script>
  const CLIENTS = <%- JSON.stringify(clients) %>;
  const clientSearch = document.getElementById('client_search');
  const clientIdInput = document.getElementById('client_id');
  const clientSuggestions = document.getElementById('client_suggestions');
  const newClientBtn = document.getElementById('new-client-btn');
  const clientModalOverlay = document.getElementById('client-modal-overlay');
  const clientModalIframe = document.getElementById('client-modal-iframe');
  const closeClientModalBtn = document.getElementById('close-client-modal');

  function renderClientSuggestions(matches) {
    clientSuggestions.innerHTML = '';

    if (matches.length === 0) {
      clientSuggestions.style.display = 'none';
      return;
    }

    matches.slice(0, 50).forEach((c) => {
      const row = document.createElement('div');
      row.className = 'suggestion-item';

      const main = document.createElement('div');
      main.textContent = c.name;
      row.appendChild(main);

      if (c.detail) {
        const detail = document.createElement('div');
        detail.className = 'suggestion-detail';
        detail.textContent = c.detail;
        row.appendChild(detail);
      }

      row.addEventListener('mousedown', (e) => {
        e.preventDefault();
        clientSearch.value = c.name;
        clientIdInput.value = c.id;
        clientSuggestions.style.display = 'none';
      });
      clientSuggestions.appendChild(row);
    });

    clientSuggestions.style.display = 'block';
  }

  function searchClients(query) {
    const q = query.trim().toLowerCase();
    if (!q) return [];
    return CLIENTS.filter((c) => c.searchText.includes(q));
  }

  clientSearch.addEventListener('input', () => {
    clientIdInput.value = '';
    renderClientSuggestions(searchClients(clientSearch.value));
  });

  clientSearch.addEventListener('focus', () => {
    if (clientSearch.value.trim()) {
      renderClientSuggestions(searchClients(clientSearch.value));
    }
  });

  document.addEventListener('click', (e) => {
    if (e.target !== clientSearch) {
      clientSuggestions.style.display = 'none';
    }
  });

  function openClientModal() {
    clientModalIframe.src = '/personas/new?modal=1';
    clientModalOverlay.style.display = 'flex';
  }

  function closeClientModal() {
    clientModalOverlay.style.display = 'none';
    clientModalIframe.src = 'about:blank';
  }

  newClientBtn.addEventListener('click', openClientModal);
  closeClientModalBtn.addEventListener('click', closeClientModal);

  window.addEventListener('message', (event) => {
    if (event.origin !== window.location.origin) return;
    const data = event.data;
    if (!data) return;

    if (data.type === 'person-created') {
      clientSearch.value = data.name;
      clientIdInput.value = data.id;
      CLIENTS.push({ id: data.id, name: data.name, detail: '', searchText: data.name.toLowerCase() });
      closeClientModal();
    } else if (data.type === 'person-modal-cancel') {
      closeClientModal();
    } else if (data.type === 'product-created') {
      if (customModalRow) {
        const fields = {
          product_code: data.sku,
          color: data.color, width: data.width, length: data.length, thickness: data.thickness,
          has_fuelle: data.has_fuelle, fuelle_type: data.fuelle_type,
          fuelle_measure_1: data.fuelle_measure_1, fuelle_measure_2: data.fuelle_measure_2,
          has_printing: data.has_printing, printing_type: data.printing_type, printing_side: data.printing_side,
          printing_colors: data.printing_colors, printing_colors_text: data.printing_colors_text,
          printing_reference: data.printing_reference
        };
        setRowPicked(customModalRow, {
          sourceType: 'inventario', productId: data.id, name: `${data.sku} — ${data.name}`,
          detail: buildCustomDetail(fields), fields
        });
        INVENTORY_ITEMS.push({
          id: data.id, sku: data.sku, name: data.name,
          searchText: [data.sku, data.name, data.color].filter(Boolean).join(' ').toLowerCase(),
          detail: buildCustomDetail(fields), searchDetail: buildCustomDetail(fields), fields
        });
      }
      closeProductModal();
      closeCustomModal();
    } else if (data.type === 'product-modal-cancel') {
      closeProductModal();
    }
  });

  // ---- Líneas de producto ----
  const INVENTORY_ITEMS = <%- JSON.stringify(inventoryItems) %>;
  const EXISTING_LINES = <%- JSON.stringify(
    (order?.items || []).map((it) => ({
      sourceType: it.source_type, productId: it.product_id, productCode: it.product_code, type: it.type, product: it.product,
      color: it.color, width: it.width, length: it.length, thickness: it.thickness,
      hasFuelle: it.has_fuelle, fuelleType: it.fuelle_type, fuelleMeasure1: it.fuelle_measure_1, fuelleMeasure2: it.fuelle_measure_2,
      hasPrinting: it.has_printing, printingType: it.printing_type, printingSide: it.printing_side,
      printingColors: it.printing_colors, printingColorsText: it.printing_colors_text, printingReference: it.printing_reference,
      quantity: it.quantity, qtyPerBundle: it.qty_per_bundle, qtyPerPackage: it.qty_per_package,
      totalKg: it.total_kg, unitPrice: it.unit_price, observation: it.observation,
      detail: it.characteristicsDetail
    }))
  ) %>;

  const itemsBody = document.getElementById('items-body');
  const addRowBtn = document.getElementById('add-row-btn');
  const subtotalEl = document.getElementById('order-subtotal');
  let rowIndex = 0;

  function rowTemplate(index) {
    return `
      <tr class="item-row">
        <td class="item-number"></td>
        <td>
          <select class="type-select" name="items[${index}][type]">
            <option value="">Selecciona...</option>
            <option value="rollo">Rollo</option>
            <option value="funda">Funda</option>
            <option value="lamina">Lámina</option>
          </select>
        </td>
        <td class="product-cell" style="position: relative;">
          <input type="hidden" class="source-type-input" name="items[${index}][source_type]" value="">
          <input type="hidden" class="product-id-input" name="items[${index}][product_id]" value="">
          <input type="hidden" class="product-code-input" name="items[${index}][product_code]" value="">
          <input type="hidden" class="product-name-input" name="items[${index}][product]" value="">
          <input type="hidden" class="color-input" name="items[${index}][color]" value="">
          <input type="hidden" class="width-input" name="items[${index}][width]" value="">
          <input type="hidden" class="length-input" name="items[${index}][length]" value="">
          <input type="hidden" class="thickness-input" name="items[${index}][thickness]" value="">
          <input type="hidden" class="has-fuelle-input" name="items[${index}][has_fuelle]" value="">
          <input type="hidden" class="fuelle-type-input" name="items[${index}][fuelle_type]" value="">
          <input type="hidden" class="fuelle-measure-1-input" name="items[${index}][fuelle_measure_1]" value="">
          <input type="hidden" class="fuelle-measure-2-input" name="items[${index}][fuelle_measure_2]" value="">
          <input type="hidden" class="has-printing-input" name="items[${index}][has_printing]" value="">
          <input type="hidden" class="printing-type-input" name="items[${index}][printing_type]" value="">
          <input type="hidden" class="printing-side-input" name="items[${index}][printing_side]" value="">
          <input type="hidden" class="printing-colors-input" name="items[${index}][printing_colors]" value="">
          <input type="hidden" class="printing-colors-text-input" name="items[${index}][printing_colors_text]" value="">
          <input type="hidden" class="printing-reference-input" name="items[${index}][printing_reference]" value="">

          <div class="product-chooser">
            <button type="button" class="btn secondary btn-pick-inventory">📦 Inventario</button>
            <button type="button" class="btn secondary btn-pick-custom">✏ Personalizado</button>
          </div>

          <div class="product-picked" style="display: none;">
            <div class="product-picked-name"></div>
            <div class="product-picked-detail"></div>
            <button type="button" class="btn secondary btn-change-product">Cambiar</button>
          </div>

          <input type="text" class="item-search" placeholder="Buscar por SKU o nombre..." autocomplete="off" style="display: none;">
          <div class="suggestions-list item-suggestions"></div>
        </td>
        <td><input type="number" step="any" class="qty-input" name="items[${index}][quantity]" style="width: 80px;"></td>
        <td><input type="number" step="any" class="bundle-input" name="items[${index}][qty_per_bundle]" style="width: 80px;"></td>
        <td><input type="number" step="any" class="package-input" name="items[${index}][qty_per_package]" style="width: 80px;"></td>
        <td><input type="number" step="any" class="kg-input" name="items[${index}][total_kg]" style="width: 80px;"></td>
        <td><input type="number" step="any" class="price-input" name="items[${index}][unit_price]" style="width: 90px;"></td>
        <td class="line-total">$0.00</td>
        <td><input type="text" class="observation-input" name="items[${index}][observation]" style="width: 150px;"></td>
        <td><button type="button" class="btn danger remove-row" style="padding: 0.3rem 0.55rem;">✕</button></td>
      </tr>
    `;
  }

  function renumberRows() {
    document.querySelectorAll('#items-body .item-row').forEach((row, i) => {
      row.querySelector('.item-number').textContent = i + 1;
    });
  }

  function updateSubtotal() {
    let sum = 0;
    document.querySelectorAll('#items-body .item-row').forEach((row) => {
      const qty = parseFloat(row.querySelector('.qty-input').value) || 0;
      const price = parseFloat(row.querySelector('.price-input').value) || 0;
      sum += qty * price;
    });
    subtotalEl.textContent = `$${sum.toFixed(2)}`;
  }

  function updateRowTotal(row) {
    const qty = parseFloat(row.querySelector('.qty-input').value) || 0;
    const price = parseFloat(row.querySelector('.price-input').value) || 0;
    row.querySelector('.line-total').textContent = `$${(qty * price).toFixed(2)}`;
    updateSubtotal();
  }

  function updateRowKg(row) {
    const width = parseFloat(row.querySelector('.width-input').value) || 0;
    const length = parseFloat(row.querySelector('.length-input').value) || 0;
    const thickness = parseFloat(row.querySelector('.thickness-input').value) || 0;
    const qty = parseFloat(row.querySelector('.qty-input').value) || 0;
    const kg = ((width * length * thickness) / 33) * qty;
    row.querySelector('.kg-input').value = kg ? Math.round(kg * 100) / 100 : '';
  }

  function positionSuggestions(row) {
    const search = row.querySelector('.item-search');
    const suggestions = row.querySelector('.item-suggestions');
    const rect = search.getBoundingClientRect();
    suggestions.style.position = 'fixed';
    suggestions.style.top = `${rect.bottom + 4}px`;
    suggestions.style.left = `${rect.left}px`;
    suggestions.style.width = `${rect.width}px`;
    suggestions.style.right = 'auto';
    suggestions.style.marginTop = '0';
  }

