    customModalRow = null;
  }

  document.getElementById('close-custom-modal').addEventListener('click', closeCustomModal);
  document.getElementById('cancel-custom-modal').addEventListener('click', closeCustomModal);

  function escapeHtml(str) {
    return String(str).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  }

  const FUELLE_LABELS = { lateral: 'Fuelle Lateral', fondo: 'Fuelle Fondo', superior_fondo: 'Fuelle Superior y Fondo' };
  const PRINTING_TYPE_LABELS = { serigrafia: 'Serigrafía', flexografia: 'Flexografía' };
  const PRINTING_SIDE_LABELS = { anverso: 'Anverso', reverso: 'Reverso', anverso_reverso: 'Anverso y Reverso' };
  const COLOR_HEX = <%- JSON.stringify(colorHexByName) %>;

  function swatchHtml(name) {
    const hex = COLOR_HEX[String(name).toLowerCase()] || '#ccc';
    return `<span class="color-swatch" style="width:11px;height:11px;margin-right:2px;vertical-align:middle;background:${hex};" title="${escapeHtml(name)}"></span>`;
  }

  function buildCustomDetail(fields) {
    const parts = [];
    if (fields.color) parts.push(`Color: ${swatchHtml(fields.color)}`);
    if (fields.width != null || fields.length != null) parts.push(`A: ${fields.width ?? '—'} · L: ${fields.length ?? '—'}`);
    if (fields.thickness != null && fields.thickness !== '') parts.push(`E: ${fields.thickness}`);
    if (fields.has_fuelle && fields.fuelle_type) {
      const measures = fields.fuelle_type === 'superior_fondo'
        ? `Sup: ${fields.fuelle_measure_1 ?? '—'} / Fon: ${fields.fuelle_measure_2 ?? '—'}`
        : `${fields.fuelle_measure_1 ?? '—'}`;
      parts.push(`${FUELLE_LABELS[fields.fuelle_type]}: ${measures}`);
    }
    if (fields.has_printing) {
      const bits = [];
      if (fields.printing_type) bits.push(PRINTING_TYPE_LABELS[fields.printing_type] || fields.printing_type);
      if (fields.printing_side) bits.push(PRINTING_SIDE_LABELS[fields.printing_side] || fields.printing_side);
      parts.push(`Impresión: ${escapeHtml(bits.join(' · ') || 'Sí')}`);
      if (fields.printing_colors_text) {
        parts.push(`Colores de Impresión: ${fields.printing_colors_text.split('/').map((s) => s.trim()).filter(Boolean).map((c) => swatchHtml(c)).join('')}`);
      } else if (fields.printing_colors) {
        parts.push(`${fields.printing_colors} color${Number(fields.printing_colors) === 1 ? '' : 'es'}`);
      }
    }
    if (fields.printing_reference) parts.push(`Ref: ${escapeHtml(fields.printing_reference)}`);
    return parts.join(' · ');
  }

  document.getElementById('save-custom-modal').addEventListener('click', () => {
    if (!customModalRow) return;
    const name = cmProduct.value.trim();
    if (!name) { alert('Escribe el nombre del producto'); cmProduct.focus(); return; }

    const selectedColor = cmColorPicker ? cmColorPicker.querySelector('input[type="radio"]:checked') : null;
    const printingColorNames = cmHasPrinting.checked ? getCmPrintingColorSelections() : [];
    const fields = {
      product_code: cmCode.value || '',
      color: selectedColor ? selectedColor.value : '',
      width: cmWidth.value || null,
      length: cmLength.value || null,
      thickness: cmThickness.value || null,
      has_fuelle: cmHasFuelle.checked ? 1 : 0,
      fuelle_type: cmHasFuelle.checked ? cmFuelleType.value : '',
      fuelle_measure_1: cmHasFuelle.checked ? (cmFuelleMeasure1.value || null) : null,
      fuelle_measure_2: cmHasFuelle.checked && cmFuelleType.value === 'superior_fondo' ? (cmFuelleMeasure2.value || null) : null,
      has_printing: cmHasPrinting.checked ? 1 : 0,
      printing_type: cmHasPrinting.checked ? cmPrintingType.value : '',
      printing_side: cmHasPrinting.checked ? cmPrintingSide.value : '',
      printing_colors: cmHasPrinting.checked ? (cmPrintingColors.value || null) : null,
      printing_colors_text: cmHasPrinting.checked ? printingColorNames.join(' / ') : '',
      printing_reference: cmHasPrinting.checked ? cmPrintingReference.value.trim() : ''
    };

    if (cmSaveToInventory.checked) {
      if (!cmCategory.value) { alert('Selecciona una categoría para guardar el producto en inventario'); cmCategory.focus(); return; }
      if (!cmCode.value) { alert('No se pudo generar un código automático para esta categoría'); return; }
      if (!cmUnit.value) { alert('Selecciona la unidad de medida'); cmUnit.focus(); return; }

      openProductModal({
        category_id: cmCategory.value, sku: cmCode.value, name, unit_id: cmUnit.value,
        color: fields.color || '', width: fields.width ?? '', length: fields.length ?? '', thickness: fields.thickness ?? '',
        has_fuelle: fields.has_fuelle ? '1' : '0',
        fuelle_type: fields.fuelle_type || '', fuelle_measure_1: fields.fuelle_measure_1 ?? '', fuelle_measure_2: fields.fuelle_measure_2 ?? '',
        has_printing: fields.has_printing ? '1' : '0',
        printing_type: fields.printing_type || '', printing_side: fields.printing_side || '',
        printing_reference: fields.printing_reference || '', printing_colors: fields.printing_colors ?? '',
        printing_colors_prefill: printingColorNames.join(',')
      });
      return;
    }

    if (cmCategory.value && cmCode.value) {
      usedCodeCounts[cmCategory.value] = (usedCodeCounts[cmCategory.value] || 0) + 1;
    }

    setRowPicked(customModalRow, {
      sourceType: 'personalizado', productId: '', name,
      detail: buildCustomDetail(fields), fields
    });
    closeCustomModal();
  });

  function searchableInventory() {
    return INVENTORY_ITEMS;
  }

  function attachRowListeners(row) {
    row.querySelector('.btn-pick-inventory').addEventListener('click', () => {
      row.querySelector('.product-chooser').style.display = 'none';
      const search = row.querySelector('.item-search');
      search.style.display = 'block';
      search.focus();
    });

    row.querySelector('.btn-pick-custom').addEventListener('click', () => {
      openCustomModal(row, false);
    });

    row.querySelector('.btn-change-product').addEventListener('click', () => {
      if (row.querySelector('.source-type-input').value === 'personalizado') {
        openCustomModal(row, true);
      } else {
        resetRowProduct(row);
      }
    });

    const search = row.querySelector('.item-search');
    search.addEventListener('input', () => {
      const q = search.value.trim().toLowerCase();
      renderRowSuggestions(row, q ? searchableInventory().filter((it) => it.searchText.includes(q)) : []);
    });
    search.addEventListener('focus', () => {
      const q = search.value.trim().toLowerCase();
      if (q) renderRowSuggestions(row, searchableInventory().filter((it) => it.searchText.includes(q)));
    });

    const qtyInput = row.querySelector('.qty-input');
    const priceInput = row.querySelector('.price-input');
    const typeSelect = row.querySelector('.type-select');

    qtyInput.addEventListener('input', () => {
      updateRowTotal(row);
      updateRowKg(row);
      if (qtyInput.value && Number(qtyInput.value) > 0) qtyInput.classList.remove('field-error');
    });
    priceInput.addEventListener('input', () => {
      updateRowTotal(row);
      if (priceInput.value && Number(priceInput.value) >= 0) priceInput.classList.remove('field-error');
    });
    typeSelect.addEventListener('change', () => {
      if (typeSelect.value) typeSelect.classList.remove('field-error');
    });

    row.querySelector('.remove-row').addEventListener('click', () => {
      row.remove();
      renumberRows();
      updateSubtotal();
    });
  }

  document.addEventListener('click', (e) => {
    document.querySelectorAll('.item-suggestions').forEach((s) => {
      if (!s.parentElement.contains(e.target)) s.style.display = 'none';
    });
  });

  function repositionVisibleSuggestions() {
    document.querySelectorAll('#items-body .item-row').forEach((row) => {
      const suggestions = row.querySelector('.item-suggestions');
      if (suggestions.style.display === 'block') positionSuggestions(row);
    });
  }

  document.getElementById('items-table-wrapper').addEventListener('scroll', repositionVisibleSuggestions);
  window.addEventListener('scroll', repositionVisibleSuggestions, true);
  window.addEventListener('resize', repositionVisibleSuggestions);

  function addRow() {
    const temp = document.createElement('tbody');
    temp.innerHTML = rowTemplate(rowIndex++);
    const newRow = temp.firstElementChild;
    itemsBody.appendChild(newRow);
    attachRowListeners(newRow);
    renumberRows();
    return newRow;
  }

  const orderFormError = document.getElementById('order-form-error');
  const orderFormErrorText = document.getElementById('order-form-error-text');

  function showFormError(message) {
    orderFormErrorText.textContent = message;
    orderFormError.style.display = 'block';
  }

  function hideFormError() {
    orderFormError.style.display = 'none';
  }

  document.getElementById('order-form-error-close').addEventListener('click', hideFormError);

  function isRowEmpty(row) {
    const hasProduct = !!row.querySelector('.product-name-input').value.trim();
    const hasType = !!row.querySelector('.type-select').value;
    const hasQty = !!row.querySelector('.qty-input').value;
    const hasPrice = !!row.querySelector('.price-input').value;
    return !hasProduct && !hasType && !hasQty && !hasPrice;
  }

  function clearRowErrors(row) {
    row.querySelectorAll('.field-error').forEach((el) => el.classList.remove('field-error'));
    row.querySelectorAll('.field-error-message').forEach((el) => el.remove());
  }

  function markFieldError(el, message) {
    el.classList.add('field-error');
    if (message) {
      const msg = document.createElement('div');
      msg.className = 'field-error-message';
      msg.textContent = message;
      el.appendChild(msg);
    }
  }

  function validateRow(row) {
    clearRowErrors(row);
    if (isRowEmpty(row)) return null;

    let firstInvalid = null;
    const typeSelect = row.querySelector('.type-select');
    const productNameInput = row.querySelector('.product-name-input');
    const productCell = row.querySelector('.product-cell');
    const qtyInput = row.querySelector('.qty-input');
    const priceInput = row.querySelector('.price-input');

    if (!productNameInput.value.trim()) {
      markFieldError(productCell, 'Selecciona o crea un producto');
      firstInvalid = firstInvalid || productCell;
    }
    if (!typeSelect.value) {
      markFieldError(typeSelect);
      firstInvalid = firstInvalid || typeSelect;
    }
    if (!qtyInput.value || Number(qtyInput.value) <= 0) {
      markFieldError(qtyInput);
      firstInvalid = firstInvalid || qtyInput;
    }
    if (!priceInput.value || Number(priceInput.value) < 0) {
      markFieldError(priceInput);
      firstInvalid = firstInvalid || priceInput;
    }

    return firstInvalid;
  }

  document.getElementById('order-form').addEventListener('submit', (e) => {
    const rows = Array.from(document.querySelectorAll('#items-body .item-row'));
    let firstInvalidEl = null;
    let anyProduct = false;

    rows.forEach((row) => {
      const invalid = validateRow(row);
      if (invalid && !firstInvalidEl) firstInvalidEl = invalid;
      if (!isRowEmpty(row) && row.querySelector('.product-name-input').value.trim()) anyProduct = true;
    });

    if (firstInvalidEl) {
      e.preventDefault();
      showFormError('Revisa los campos resaltados en rojo: faltan datos obligatorios en una o más líneas.');
      firstInvalidEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
      if (firstInvalidEl.focus) firstInvalidEl.focus();
      return;
    }

    if (!anyProduct) {
      e.preventDefault();
      showFormError('Agrega al menos un producto a la orden.');
      document.getElementById('items-table-wrapper').scrollIntoView({ behavior: 'smooth', block: 'center' });
      return;
    }

    hideFormError();
  });

  addRowBtn.addEventListener('click', addRow);

  if (EXISTING_LINES.length > 0) {
    EXISTING_LINES.forEach((line) => {
      const row = addRow();
      row.querySelector('.type-select').value = line.type || '';
      row.querySelector('.qty-input').value = line.quantity ?? '';
      row.querySelector('.bundle-input').value = line.qtyPerBundle ?? '';
      row.querySelector('.package-input').value = line.qtyPerPackage ?? '';
      row.querySelector('.kg-input').value = line.totalKg ?? '';
      row.querySelector('.price-input').value = line.unitPrice ?? '';
      row.querySelector('.observation-input').value = line.observation || '';

      if (line.product) {
        setRowPicked(row, {
          sourceType: line.sourceType || 'personalizado',
          productId: line.productId || '',
          name: line.product,
          detail: line.detail,
          fields: {
            product_code: line.productCode,
            color: line.color, width: line.width, length: line.length, thickness: line.thickness,
            has_fuelle: line.hasFuelle, fuelle_type: line.fuelleType,
            fuelle_measure_1: line.fuelleMeasure1, fuelle_measure_2: line.fuelleMeasure2,
            has_printing: line.hasPrinting, printing_type: line.printingType, printing_side: line.printingSide,
            printing_colors: line.printingColors, printing_colors_text: line.printingColorsText, printing_reference: line.printingReference
          }
        });
        row.querySelector('.kg-input').value = line.totalKg ?? '';
      }
      updateRowTotal(row);
    });
  } else {
    addRow();
    addRow();
    addRow();
  }

  updateSubtotal();
</script>

