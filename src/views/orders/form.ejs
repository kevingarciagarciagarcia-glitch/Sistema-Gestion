  function resetRowProduct(row) {
    ['.source-type-input', '.product-id-input', '.product-code-input', '.product-name-input', '.color-input', '.width-input', '.length-input',
     '.thickness-input', '.has-fuelle-input', '.fuelle-type-input', '.fuelle-measure-1-input', '.fuelle-measure-2-input',
     '.has-printing-input', '.printing-type-input', '.printing-side-input', '.printing-colors-input', '.printing-colors-text-input', '.printing-reference-input']
      .forEach((sel) => { row.querySelector(sel).value = ''; });

