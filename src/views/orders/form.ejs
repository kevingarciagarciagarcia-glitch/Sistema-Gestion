    row.querySelector('.thickness-input').value = fields.thickness ?? '';
    row.querySelector('.has-fuelle-input').value = fields.has_fuelle ? '1' : '';
    row.querySelector('.fuelle-type-input').value = fields.fuelle_type || '';
    row.querySelector('.fuelle-measure-1-input').value = fields.fuelle_measure_1 ?? '';
    row.querySelector('.fuelle-measure-2-input').value = fields.fuelle_measure_2 ?? '';
    row.querySelector('.has-printing-input').value = fields.has_printing ? '1' : '';
